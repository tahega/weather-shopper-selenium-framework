<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="UI Automation Suite" verbose="1" parallel="classes" thread-count="3">
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="org.bp.com.uiautomation.listeners.Listeners"/>
    </listeners>
    <test name="Main Page Tests">
        <classes>
            <class name="org.bp.com.uiautomation.MainPageTest"/>
        </classes>
    </test>
    <test name="SunScreen Page Tests">
        <classes>
            <class name="org.bp.com.uiautomation.SunScreenPageTest"/>
        </classes>
    </test>
    <test name="Moisturizer Page Tests">
        <classes>
            <class name="org.bp.com.uiautomation.MoisturizerPageTest"/>
        </classes>
    </test>
</suite>
